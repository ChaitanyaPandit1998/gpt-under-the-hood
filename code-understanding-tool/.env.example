# Optional benchmark and chapter-cover credentials (server only).
# Never commit a real token or use VITE_* names for secrets. Restart Vite after changes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional local document export. Only the tested macOS universal 0.18.1 binary
# is accepted (checksum verified). No automatic download or installation.
ENABLE_EXPERIMENTAL_DOCUMENT_EXPORT=0
WORDCRAFT_CLI_PATH=
ENABLE_EXPERIMENTAL_DIAGRAM_EXPORT=0
VECTORCRAFT_CLI_PATH=
ENABLE_EXPERIMENTAL_COMPACT_VISUAL_PLANNING=0
