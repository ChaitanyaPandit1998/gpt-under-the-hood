{
  "name": "code-understanding-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "eval:baseline": "node --experimental-strip-types evals/run.mjs",
    "eval:images": "node --experimental-strip-types evals/cloudflare-images.mjs",
    "eval:deckcraft": "node evals/deckcraft-pilot.mjs",
    "eval:wordcraft": "node evals/wordcraft-pilot.mjs",
    "eval:vectorcraft": "node evals/vectorcraft-pilot.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "vitest run src/domain/visual-evaluation.test.ts src/domain/visual-label-layout.test.ts src/domain/visual-review-draft.test.ts src/server/visual-evaluation-runner.test.ts src/server/visual-png.test.ts src/server/visual-review-service.test.ts src/server/visual-review-request.test.ts",
    "test:e2e": "playwright test",
    "check:all": "npm run check && npm run test:e2e",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
